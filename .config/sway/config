# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

# Single source of truth for Sway colors: the active generated theme.
include $HOME/.config/sway/themes/active.conf

# User overrides may still be placed here, but the actual palette is managed
# centrally by ~/.config/sway/themes/theme.sh.
include $HOME/.config/sway/definitions.d/theme.conf

# global variables
include $HOME/.config/sway/definitions.d/*.conf

include $HOME/.config/sway/inputs/*.conf

# enable modes
include $HOME/.config/sway/modes/*.conf

# only enable this if every app you use is compatible with wayland
# xwayland disable

# include additional configs e.g. to autostart applications
include $HOME/.config/sway/config.d/*.conf
